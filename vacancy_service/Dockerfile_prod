# Используем официальный образ Go в качестве базового
FROM golang:1.25 AS builder

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы зависимостей (go.mod, go.sum) первыми
COPY go.mod go.sum ./

# Загружаем зависимости — это создаст отдельный слой,
# и при изменении кода или зависимостей следующая сборка будет быстрой
RUN go mod download

# Копируем весь исходный код
COPY . .

# Собираем приложение
# Флаг CGO_ENABLED=0 собирает бинарник статически (все зависимости внутри), то позволяет запускать его на очень минималистичных образах
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -a -installsuffix cgo -o main ./cmd/vacancy

# Указываем порт, на котором приложение будет слушать
EXPOSE 8080

# Задаём команду для запуска контейнера
CMD ["./main"]