POSTGRES_USER=root
POSTGRES_PASSWORD=change-me
POSTGRES_DB=job
DATABASE_URL=postgresql://root:change-me@postgres:5432/job?schema=public
POSTGRES_PORT=5425
VACANCY_PORT=5003
VACANCY_GRPC_PORT=50051
VACANCY_GRPC_TIMEOUT_MS=3000
GATEWAY_PORT=3000
NGINX_PORT=80
REDIS_PASSWORD=change-me
REDIS_CONNECT_TIMEOUT_MS=500

# Auth service
AUTH_GRPC_PORT=5005
AUTH_GRPC_URL=auth_service:5005
AUTH_GRPC_TIMEOUT_MS=3000
USER_GRPC_URL=user_service:5000
USER_GRPC_TIMEOUT_MS=3000
AUTH_DATABASE_URL=postgresql://root:change-me@postgres:5432/job?schema=auth
AUTH_SESSION_NAMESPACE=job-aggregator:auth
# Base64 RSA keys: PKCS#8 private key for Auth and matching SPKI public key for Gateway.
JWT_ACCESS_PRIVATE_KEY_BASE64=
JWT_ACCESS_PUBLIC_KEY_BASE64=
JWT_REFRESH_SECRET=replace-with-another-32-character-random-secret
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=job-aggregator-auth
JWT_AUDIENCE=job-aggregator-services

# User service
USER_GRPC_PORT=5000
USER_DATABASE_URL=postgresql://root:change-me@postgres:5432/job?schema=user

CACHE_TTL_MS=15000
CACHE_NAMESPACE=job-aggregator:gateway
CACHE_FAILURE_COOLDOWN_MS=5000
LOG_LEVEL=debug
LOG_DIR=/var/log/vacancy-service
