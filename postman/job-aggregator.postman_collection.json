{
  "info": {
    "_postman_id": "f45ec37f-60ce-45de-a0a4-54566ced3e4d",
    "name": "Job Aggregator API",
    "description": "All public Gateway HTTP endpoints. Run folders in collection order: setup variables and created entity IDs are saved automatically. Use the Local WSL, Docker via Nginx, or Production template environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response is not a server error', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});",
          "pm.test('Response is JSON', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "pm.test('Response time is within the diagnostic limit', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(Number(pm.collectionVariables.get('max_response_time_ms')));",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Setup and Auth",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "description": "Gateway liveness check."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = `postman.${Date.now()}@example.com`;",
                  "pm.collectionVariables.set('email', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('user_id', json.user.id);",
                  "pm.collectionVariables.set('access_token', json.tokens.access_token);",
                  "pm.collectionVariables.set('refresh_token', json.tokens.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"first_name\": \"Иван\",\n  \"last_name\": \"Петров\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.tokens.access_token);",
                  "pm.collectionVariables.set('refresh_token', json.tokens.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.access_token);",
                  "pm.collectionVariables.set('refresh_token', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Current principal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('JWT belongs to registered user', () => pm.expect(pm.response.json().user_id).to.eql(pm.collectionVariables.get('user_id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/auth/me"
          }
        }
      ]
